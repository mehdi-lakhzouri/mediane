# Store every text file with LF line endings, whatever the contributor's OS
# or core.autocrlf setting. Without this, Git for Windows (autocrlf=true by
# default) checks files out as CRLF and reports unchanged files as modified.
* text=auto eol=lf

# Windows-only scripts must keep CRLF to run correctly
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Binary assets: never diff or convert
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.webp binary
*.woff binary
*.woff2 binary
*.ttf binary
*.otf binary
*.jar binary
*.pdf binary
*.zip binary
