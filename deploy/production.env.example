# ---------------------------------------------------------------------------
# CabinGuard PRODUCTION configuration - the VM (/opt/cabinguard/.env).
#
# Template only: nobody copies this file by hand. The deploy workflow
# (.github/workflows/deploy.yml) writes the real file on the VM, mode 600, from
# the GitHub environment "production". Each value below says where it comes
# from. Local development uses backend/.env.example instead.
#
# The API refuses to start in production unless: HTTPS origins, Secure
# cookies, Swagger off, and S3 storage (or STORAGE_LOCAL_IN_PRODUCTION=true).
# ---------------------------------------------------------------------------

# --- App (fixed by the workflow) --------------------------------------------
NODE_ENV=production
PORT=4000
LOG_LEVEL=info
# Caddy is the only proxy in front of the API.
TRUST_PROXY=1
# https://<variable APP_DOMAIN>
CORS_ORIGINS=https://app.vunlera.tn
FRONTEND_URL=https://app.vunlera.tn
# https://<variable API_DOMAIN> (signed links to uploaded photos)
API_PUBLIC_URL=https://api.vunlera.tn
SWAGGER_ENABLED=false
COOKIE_SECURE=true
COOKIE_SAME_SITE=strict

# --- Database: PostgreSQL container on the VM, internal network only --------
# secret POSTGRES_PASSWORD - generate: openssl rand -hex 32 (alphanumeric: it goes into the URL)
POSTGRES_PASSWORD=replace_with_openssl_rand_hex_32
DATABASE_URL=postgresql://cabinguard:replace_with_openssl_rand_hex_32@postgres:5432/cabinguard

# --- Auth and encryption ------------------------------------------------------
# secrets JWT_ACCESS_SECRET and TOKEN_HASH_SECRET - generate each: openssl rand -base64 48 (two different values)
JWT_ACCESS_SECRET=replace_with_openssl_rand_base64_48
TOKEN_HASH_SECRET=replace_with_another_openssl_rand_base64_48
# secrets MFA_ENCRYPTION_KEY and DEVICE_ENCRYPTION_KEY - generate each: openssl rand -base64 32
# NEVER change or lose them once users exist: enrolled authenticators and
# in-cabin device secrets can no longer be decrypted.
MFA_ENCRYPTION_KEY=replace_with_openssl_rand_base64_32
DEVICE_ENCRYPTION_KEY=replace_with_another_openssl_rand_base64_32

# --- Mail: Gmail SMTP with an app password ------------------------------------
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
# STARTTLS (enforced as soon as credentials are set)
MAIL_SECURE=false
# secret MAIL_USER (the Gmail address) and secret MAIL_PASSWORD (an app password, not the account password)
MAIL_USER=you@gmail.com
MAIL_PASSWORD=your_16_char_app_password
# variable MAIL_FROM - Gmail rewrites the sender to the authenticated account
MAIL_FROM="CabinGuard <you@gmail.com>"

# --- File storage: photos on the VM for this single-server demo ---------------
# A Docker volume mounted at /data/uploads. No redundancy: move to S3/R2 with
# STORAGE_DRIVER=s3 + S3_BUCKET, S3_REGION, S3_ENDPOINT, S3_ACCESS_KEY_ID,
# S3_SECRET_ACCESS_KEY, and remove STORAGE_LOCAL_IN_PRODUCTION.
STORAGE_DRIVER=local
STORAGE_LOCAL_IN_PRODUCTION=true

# --- In-cabin safety ----------------------------------------------------------
SAFETY_WORKER_ENABLED=true
