# Copy to deploy/.env on the VPS. Never commit the real file.
# Replace api.example.com and your-project.vercel.app with your actual addresses.
API_DOMAIN=api.example.com
BACKEND_IMAGE=ghcr.io/mehdi-lakhzouri/cabinguard-backend:main
MIGRATE_IMAGE=ghcr.io/mehdi-lakhzouri/cabinguard-migrate:main
# For repeatable releases, pin BOTH images to the same sha-xxxxxxx tag or digest.

NODE_ENV=production
PORT=4000
LOG_LEVEL=info
# Caddy is the immediate proxy; devices also connect through Caddy directly.
TRUST_PROXY=1
CORS_ORIGINS=https://your-project.vercel.app
FRONTEND_URL=https://your-project.vercel.app
MOBILE_LINK_URL=https://your-project.vercel.app/mobile
API_PUBLIC_URL=https://api.example.com
SWAGGER_ENABLED=false
COOKIE_SECURE=true
COOKIE_SAME_SITE=strict

# Generate with openssl rand -hex 32. Use the same value in DATABASE_URL.
POSTGRES_PASSWORD=replace_with_openssl_rand_hex_32
DATABASE_URL=postgresql://cabinguard:replace_with_openssl_rand_hex_32@postgres:5432/cabinguard
# Generate separately with openssl rand -base64 48.
JWT_ACCESS_SECRET=replace_with_openssl_rand_base64_48
TOKEN_HASH_SECRET=replace_with_another_openssl_rand_base64_48
WEB_SESSION_IDLE_TTL_SECONDS=1800
# Generate separately with openssl rand -base64 32 FOR A NEW INSTALLATION ONLY.
# When migrating, preserve all existing secrets, including the absence of a
# dedicated DEVICE_ENCRYPTION_KEY if it was derived from MFA_ENCRYPTION_KEY.
MFA_ENCRYPTION_KEY=replace_with_openssl_rand_base64_32
DEVICE_ENCRYPTION_KEY=replace_with_another_openssl_rand_base64_32

MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_SECURE=false
MAIL_USER=you@example.com
MAIL_PASSWORD=replace_with_smtp_app_password
MAIL_FROM="Mediane <you@example.com>"
# Optional SMS delivery. Leave unset unless intentionally configured.
# TEXTBEE_API_KEY=
# TEXTBEE_DEVICE_ID=

STORAGE_DRIVER=local
STORAGE_LOCAL_IN_PRODUCTION=true
# Keep false while testing a copied database. Enable on the final active server.
SAFETY_WORKER_ENABLED=false
