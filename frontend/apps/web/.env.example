# Copy to .env.local. Inlined into the browser bundle at build time.
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000/api/v1

# Vercel production (replace the local value above):
# NEXT_PUBLIC_API_BASE_URL=/api/v1
# API_PROXY_TARGET=https://api.example.com
# API_PROXY_TARGET is the HTTPS origin only, without /api/v1. Redeploy after changes.
