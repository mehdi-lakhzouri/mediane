# -----------------------------------------------------------------------
# Root-level ignores for this monorepo (NestJS backend, Next.js/Turborepo
# frontend, Flutter driver_health_app). Each project keeps its own more
# specific .gitignore; these rules are the safety net for the repo root
# itself, so a stray install or build at the top level never gets staged.
# -----------------------------------------------------------------------

# Dependencies
node_modules/
.pnp/
.pnp.js

# Build outputs
dist/
build/
out/
.next/
.turbo/
.vercel/

# Flutter's lib/ (driver_health_app's actual Dart source) must never match
# here — anchored to the repo root only.
/lib/
/lib64/

# Environment files — secrets live here, never commit them
.env
.env.*
!.env.example

# Logs
*.log
npm-debug.log*
pnpm-debug.log*
yarn-debug.log*
yarn-error.log*

# Test / coverage output
coverage/
.nyc_output/
playwright-report/
test-results/
blob-report/
# Saved E2E sessions and the enrolled test authenticator
e2e/.auth/
# DAST output (ZAP reports)
zap-reports/

# OS cruft
.DS_Store
Thumbs.db

# Editor cruft
.vscode/*
!.vscode/extensions.json
.idea/
*.swp

# TypeScript build info
*.tsbuildinfo

# Scratch output (local previews, screenshots) — never part of the repo
.tmp-*/

# Local design explorations and marketing-video source/assets are not shipped
/design/
/marketing/
