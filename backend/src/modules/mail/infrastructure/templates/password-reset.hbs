<html lang='fr'>
  <head>
    <meta charset='utf-8' />
    <meta name='viewport' content='width=device-width, initial-scale=1' />
    <meta name='color-scheme' content='light' />
    <title>Réinitialisation du mot de passe Mediane</title>
    <style>
      @media only screen and (max-width: 640px) {
        .email-shell {
          width: 100% !important;
        }
        .email-pad {
          padding-right: 24px !important;
          padding-left: 24px !important;
        }
        .email-title {
          font-size: 28px !important;
          line-height: 34px !important;
        }
        .email-button {
          display: block !important;
        }
      }
    </style>
  </head>
  <body
    style='margin: 0; padding: 0; background: #eef5fa; color: #102a43; font-family: Arial, Helvetica, sans-serif;'
  >
    <div
      style='display: none; max-height: 0; overflow: hidden; opacity: 0;'
    >Votre lien sécurisé de réinitialisation Mediane.</div>
    <table
      role='presentation'
      width='100%'
      cellspacing='0'
      cellpadding='0'
      border='0'
      style='width: 100%; background: #eef5fa;'
    ><tr><td align='center' style='padding: 32px 12px;'>
          <table
            class='email-shell'
            role='presentation'
            width='600'
            cellspacing='0'
            cellpadding='0'
            border='0'
            style='width: 600px; max-width: 600px; overflow: hidden; border: 1px solid #d8e8f3; border-radius: 24px; background: #ffffff; box-shadow: 0 18px 55px rgba(35, 91, 130, 0.12);'
          >
            <tr><td style='padding: 0; line-height: 0;'><img
                  src='cid:mediane-email-banner@mediane'
                  width='600'
                  alt='Mediane'
                  style='display: block; width: 100%; height: auto; border: 0; border-radius: 23px 23px 0 0;'
                /></td></tr>
            <tr><td class='email-pad' style='padding: 28px 42px 12px;'><table
                  role='presentation'
                  width='100%'
                  cellspacing='0'
                  cellpadding='0'
                  border='0'
                ><tr><td><table
                        role='presentation'
                        cellspacing='0'
                        cellpadding='0'
                        border='0'
                      ><tr><td
                            align='center'
                            width='46'
                            height='46'
                            style='width: 46px; height: 46px; border-radius: 14px; background: #eaf5ff; color: #087fcf; font-size: 15px; font-weight: 800;'
                          >M</td><td
                            style='padding-left: 12px; color: #102a43; font-size: 22px; font-weight: 800; letter-spacing: -0.7px;'
                          >Medi<span
                              style='color: #1da9c4;'
                            >ane</span></td></tr></table></td><td
                      align='right'
                      style='color: #087fcf; font-size: 11px; font-weight: 700; letter-spacing: 1.5px; text-transform: uppercase;'
                    >Sécurité du compte</td></tr></table></td></tr>
            <tr><td class='email-pad' style='padding: 22px 42px 38px;'>
                <h1
                  class='email-title'
                  style='margin: 0; color: #102a43; font-size: 34px; line-height: 40px; letter-spacing: -1.2px;'
                >Réinitialisez votre mot de passe</h1>
                <p
                  style='margin: 14px 0 0; color: #5c7188; font-size: 16px; line-height: 26px;'
                >Bonjour
                  {{firstName}}, nous avons reçu une demande de nouveau mot de
                  passe pour votre compte Mediane.</p>
                <table
                  role='presentation'
                  width='100%'
                  cellspacing='0'
                  cellpadding='0'
                  border='0'
                  style='margin-top: 26px;'
                ><tr><td
                      align='center'
                      bgcolor='#1d92fa'
                      style='border-radius: 14px; background: #1d92fa; box-shadow: 0 9px 24px rgba(29, 146, 250, 0.24);'
                    ><a
                        class='email-button'
                        href='{{resetUrl}}'
                        style='display: inline-block; padding: 17px 28px; color: #ffffff; font-size: 16px; font-weight: 700; text-decoration: none;'
                      >Choisir un nouveau mot de passe →</a></td></tr></table>
                <table
                  role='presentation'
                  width='100%'
                  cellspacing='0'
                  cellpadding='0'
                  border='0'
                  style='margin-top: 24px; border: 1px solid #d9e8f3; border-radius: 16px; background: #f7fbfe;'
                ><tr><td
                      width='48'
                      valign='top'
                      style='padding: 18px 0 18px 18px; color: #1da9c4; font-size: 22px;'
                    >◷</td><td
                      style='padding: 17px 18px 17px 0; color: #526f87; font-size: 13px; line-height: 21px;'
                    ><strong style='color: #27445d;'>Lien à usage unique</strong><br
                      />Il expire le
                      {{expiresAt}}
                      et devient inutilisable dès que votre mot de passe est
                      modifié.</td></tr></table>
                <div
                  style='margin-top: 24px; padding: 16px 18px; border-left: 3px solid #31baff; border-radius: 8px; background: #eef8fe; color: #526f87; font-size: 12px; line-height: 19px;'
                ><strong style='color: #27445d;'>Vous n’êtes pas à l’origine de
                    cette demande ?</strong><br />Ignorez simplement cet email.
                  Votre mot de passe actuel reste valide et votre compte demeure
                  protégé.</div>
                <p
                  style='margin: 24px 0 0; color: #8299aa; font-size: 11px; line-height: 17px; word-break: break-all;'
                >Le bouton ne fonctionne pas ? Copiez ce lien dans votre
                  navigateur :<br /><a
                    href='{{resetUrl}}'
                    style='color: #087fcf; text-decoration: underline;'
                  >{{resetUrl}}</a></p>
              </td></tr>
            <tr><td
                align='center'
                style='padding: 20px 28px 24px; border-top: 1px solid #e3edf4; color: #8299aa; font-size: 11px; line-height: 18px;'
              >© Mediane · Vos données et vos accès restent privés.</td></tr>
          </table>
        </td></tr></table>
  </body>
</html>