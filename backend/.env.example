# ---------------------------------------------------------------------------
# CabinGuard API - copy to .env and fill in. Validated at startup
# (src/config/env.validation.ts): the app refuses to boot on invalid values.
# Generate secrets with:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# ---------------------------------------------------------------------------

# --- App --------------------------------------------------------------------
NODE_ENV=development
PORT=4000
# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info
# Comma-separated exact origins allowed to call the API with credentials (never *)
CORS_ORIGINS=http://localhost:3000
# Used to build links in emails (invitation, password reset)
FRONTEND_URL=http://localhost:3000
# Links meant for the driver app: driver invitations and family invites. On a
# phone with the app they open in it (Android App Links), elsewhere a page hands
# them over. Default: FRONTEND_URL/mobile. Administrators keep web links.
# MOBILE_LINK_URL=https://app.vunlera.tn/mobile
# Number of reverse proxies in front of the API (0 = direct). Drives req.ip.
TRUST_PROXY=0
# Forced to false in production
SWAGGER_ENABLED=true

# --- Mobile application bootstrap -----------------------------------------
# Semantic versions used to allow, recommend, or block a mobile release.
MOBILE_MINIMUM_SUPPORTED_VERSION=1.0.0
MOBILE_LATEST_VERSION=1.0.0
MOBILE_MAINTENANCE=false
# Optional user-facing maintenance details.
# MOBILE_MAINTENANCE_MESSAGE=CabinGuard is receiving a safety update. Please try again shortly.
# MOBILE_MAINTENANCE_ENDS_AT=2026-10-03T23:00:00Z
MOBILE_TERMS_VERSION=2026-10-01
MOBILE_PRIVACY_VERSION=2026-10-01
# Defaults are FRONTEND_URL/terms, /privacy and /support.
# MOBILE_TERMS_URL=https://cabinguard.app/terms
# MOBILE_PRIVACY_URL=https://cabinguard.app/privacy
# MOBILE_SUPPORT_URL=https://cabinguard.app/support
MOBILE_SELF_REGISTRATION=false
MOBILE_BIOMETRIC_UNLOCK=true
MOBILE_FAMILY_JOIN=true

# --- Database (matches docker/compose.yaml) -------------------------------
DATABASE_URL=postgresql://cabinguard:replace_with_a_strong_postgres_password@127.0.0.1:5432/cabinguard

# --- Auth -------------------------------------------------------------------
# >= 32 chars, must differ from TOKEN_HASH_SECRET
JWT_ACCESS_SECRET=replace_with_a_random_secret_of_at_least_32_chars
JWT_ACCESS_TTL_SECONDS=900
JWT_ISSUER=cabinguard-api
JWT_AUDIENCE=cabinguard-web
REFRESH_SESSION_IDLE_TTL_SECONDS=604800
REFRESH_SESSION_ABSOLUTE_TTL_SECONDS=2592000
# HMAC key for refresh/invitation/reset token hashes and CSRF signatures (>= 32 chars)
TOKEN_HASH_SECRET=replace_with_another_random_secret_of_32_chars_min
# AES-256-GCM key protecting TOTP secrets at rest: 32 random bytes in base64.
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Keep it stable: changing or losing it breaks every enrolled authenticator.
MFA_ENCRYPTION_KEY=replace_with_32_random_bytes_in_base64_xxxxxxxx=
# Name shown next to the account in authenticator apps
MFA_ISSUER=CabinGuard
INVITATION_TTL_SECONDS=259200
PASSWORD_RESET_TTL_SECONDS=1800

# --- Cookies ----------------------------------------------------------------
# Must be true in production. false only for plain-http local development.
COOKIE_SECURE=false
# strict | lax
COOKIE_SAME_SITE=strict

# --- Mail -------------------------------------------------------------------
# Gmail with a Google account App Password (NOT your normal password):
#   1. Enable 2-Step Verification on the Google account
#   2. https://myaccount.google.com/apppasswords -> create one for "CabinGuard"
#   3. Paste the 16 characters below, spaces removed
# Port 587 upgrades with STARTTLS (MAIL_SECURE=false); port 465 is implicit TLS
# (MAIL_SECURE=true). Whenever credentials are set, an un-upgraded connection is
# refused, so the app password is never sent in clear.
# For a local catcher instead (Mailpit): host=localhost port=1025, no user/password.
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_SECURE=false
MAIL_USER=you@gmail.com
MAIL_PASSWORD=your_16_char_app_password
# Gmail rewrites the sender to the authenticated account, so keep them the same.
MAIL_FROM="CabinGuard <you@gmail.com>"

# --- File storage (driver profile photos) -----------------------------------
# local = a folder on this server (development only, refused in production)
# s3    = any S3-compatible bucket: AWS S3, MinIO, Cloudflare R2 (production)
STORAGE_DRIVER=local
# local driver: folder for uploads, relative to the backend folder (gitignored)
STORAGE_LOCAL_DIR=uploads
# Public base URL of this API, used in signed photo links. Default: http://localhost:PORT
# On a phone/emulator, use an address the device can reach (e.g. http://10.0.2.2:4000 on Android).
# API_PUBLIC_URL=http://localhost:4000
# s3 driver: the bucket must stay private (Block Public Access on, default encryption on).
# S3_BUCKET=cabinguard-avatars
# S3_REGION=eu-west-3
# Only for S3-compatible services other than AWS (MinIO, R2...):
# S3_ENDPOINT=http://localhost:9000
# S3_FORCE_PATH_STYLE=true
# Leave both empty to use the default AWS credential chain (IAM role recommended):
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=

# --- Rate limiting (global fallback; sensitive routes have stricter code-level policies)
THROTTLE_DEFAULT_TTL_SECONDS=60
THROTTLE_DEFAULT_LIMIT=100

# --- In-cabin devices and safety ----------------------------------------------
# Optional dedicated key for device secrets (32 bytes, base64). When unset, a
# separate key is derived from MFA_ENCRYPTION_KEY.
# DEVICE_ENCRYPTION_KEY=
DEVICE_SIGNATURE_WINDOW_SECONDS=300
# "I'm OK" countdown before escalation (critical: cardiac arrest, stroke,
# seizure; urgent: heart rhythm). Drowsiness never escalates.
SAFETY_CRITICAL_RESPONSE_SECONDS=30
SAFETY_URGENT_RESPONSE_SECONDS=60
SAFETY_WORKER_ENABLED=true
SAFETY_WORKER_INTERVAL_MS=2000
SAFETY_AUTO_CLOSE_HOURS=24
SAFETY_EVENT_RETENTION_DAYS=90
SAFETY_INCIDENT_RETENTION_DAYS=365
