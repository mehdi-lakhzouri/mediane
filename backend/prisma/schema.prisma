// Prisma 7 schema. The connection URL lives in prisma.config.ts, not here.
// Conventions:
//   - UUIDv7 primary keys (time-ordered, good B-tree locality)
//   - secrets (passwords, tokens) are NEVER stored in clear: only Argon2id or HMAC-SHA256 hashes
//   - cascades only for owned/composed data (profile, sessions, tokens); audit logs have no FK
//     so that a hard delete never rewrites or erases the audit trail.

generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "cjs"
  // Extensionless imports: resolvable by tsc (CommonJS), ts-node (CLI) and ts-jest alike.
  importFileExtension = ""
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  DRIVER
}

/// Administrative lifecycle only. Onboarding progress (password change, profile) and
/// soft deletion are stored as independent facts; the effective account state is derived
/// in the domain layer (see modules/users/domain/account-state.ts).
enum UserStatus {
  INVITED
  ACTIVE
  SUSPENDED
}

/// EXPIRED is not stored: it is derived from expiresAt so it can never drift.
enum InvitationStatus {
  PENDING
  ACCEPTED
  REVOKED
  SUPERSEDED
}

enum SessionRevocationReason {
  LOGOUT
  LOGOUT_ALL
  PASSWORD_CHANGED
  TOKEN_REUSE_DETECTED
  USER_SUSPENDED
  USER_DELETED
  ADMIN_REVOKED
}

/// Which client a session belongs to. Bound at login and checked on every request:
/// a web session cannot be used with a Bearer token and a mobile token cannot be
/// sent as a cookie.
enum SessionChannel {
  WEB
  MOBILE
}

enum Gender {
  MALE
  FEMALE
}

enum EmergencyContactRelationship {
  SPOUSE
  PARENT
  CHILD
  SIBLING
  RELATIVE
  FRIEND
  COLLEAGUE
  OTHER
}

enum FamilyRole {
  OWNER
  MEMBER
}

enum FamilyJoinRequestStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
  EXPIRED
}

enum AuditActorType {
  USER
  SYSTEM
  CLI
  DEVICE
}

enum AuditOutcome {
  SUCCESS
  FAILURE
}

model User {
  id                         String     @id @default(uuid(7)) @db.Uuid
  /// Always normalized (trim + lowercase) by the Email value object before persistence.
  /// Unique across ALL rows, including soft-deleted ones: a deleted account must be restored
  /// or hard-deleted before its email can be reused (prevents identity confusion).
  email                      String     @unique @db.VarChar(254)
  /// Argon2id hash (PHC string). Temporary passwords are stored the same way.
  passwordHash               String     @db.VarChar(255)
  role                       Role
  status                     UserStatus @default(INVITED)
  firstName                  String     @db.VarChar(100)
  lastName                   String     @db.VarChar(100)
  mustChangePassword         Boolean    @default(false)
  /// Temporary passwords stop being accepted after this instant.
  temporaryPasswordExpiresAt DateTime?
  passwordChangedAt          DateTime?
  emailVerifiedAt            DateTime?
  profileCompletedAt         DateTime?
  /// Set when a TOTP authenticator is confirmed. Drives the MFA login step and,
  /// for roles that require MFA, the MFA_SETUP_REQUIRED onboarding state.
  mfaEnabledAt               DateTime?
  lastLoginAt                DateTime?
  failedLoginAttempts        Int        @default(0)
  lockedUntil                DateTime?
  suspendedAt                DateTime?
  deletedAt                  DateTime?
  createdById                String?    @db.Uuid
  createdAt                  DateTime   @default(now())
  updatedAt                  DateTime   @updatedAt

  createdBy           User?                    @relation("UserCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  createdUsers        User[]                   @relation("UserCreatedBy")
  profile             UserProfile?
  invitations         Invitation[]             @relation("InvitationInvitee")
  sentInvitations     Invitation[]             @relation("InvitationInviter")
  revokedInvitations  Invitation[]             @relation("InvitationRevoker")
  sessions            RefreshSession[]
  passwordResetTokens PasswordResetToken[]
  emailVerifications  EmailVerificationToken[]
  mfa                 UserMfa?
  mfaRecoveryCodes    MfaRecoveryCode[]
  mfaChallenges       MfaChallenge[]
  familyMembership    FamilyMember?
  familyJoinRequests  FamilyJoinRequest[]
  pairedDevice        VehicleDevice?           @relation("DevicePairedUser")
  medicalEvents       MedicalEvent[]
  incidents           Incident[]
  notifications       UserNotification[]
  notificationPrefs   NotificationPreference?

  @@index([role, status, deletedAt])
  @@index([deletedAt])
  @@map("users")
}

/// Driver profile (personal data: never logged, never put in tokens or audit metadata).
/// Columns are nullable so the avatar can be uploaded at any point of onboarding;
/// completeness is a domain rule (see modules/profiles/domain/user-profile.ts).
model UserProfile {
  id              String    @id @default(uuid(7)) @db.Uuid
  userId          String    @unique @db.Uuid
  /// E.164, e.g. +21612345678
  phoneNumber     String?   @db.VarChar(32)
  dateOfBirth     DateTime? @db.Date
  gender          Gender?
  /// Object-storage key (never a URL): URLs are signed on read and expire.
  avatarKey       String?   @db.VarChar(255)
  avatarUpdatedAt DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  /// Composition: a profile cannot outlive its user (only reachable through an explicit hard delete).
  user              User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  emergencyContacts EmergencyContact[]

  @@map("user_profiles")
}

/// People to call when the driver has an incident, in priority order (1 = first).
model EmergencyContact {
  id           String                       @id @default(uuid(7)) @db.Uuid
  profileId    String                       @db.Uuid
  fullName     String                       @db.VarChar(200)
  relationship EmergencyContactRelationship
  /// E.164, e.g. +21698765432
  phoneNumber  String                       @db.VarChar(32)
  priority     Int                          @db.SmallInt
  createdAt    DateTime                     @default(now())
  updatedAt    DateTime                     @updatedAt

  profile UserProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@unique([profileId, priority])
  @@map("emergency_contacts")
}

model Invitation {
  id          String           @id @default(uuid(7)) @db.Uuid
  userId      String           @db.Uuid
  invitedById String?          @db.Uuid
  /// HMAC-SHA256 (hex) of the raw token. The raw token only exists in the email link.
  tokenHash   String           @unique @db.Char(64)
  status      InvitationStatus @default(PENDING)
  expiresAt   DateTime
  acceptedAt  DateTime?
  revokedAt   DateTime?
  revokedById String?          @db.Uuid
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  user      User  @relation("InvitationInvitee", fields: [userId], references: [id], onDelete: Cascade)
  invitedBy User? @relation("InvitationInviter", fields: [invitedById], references: [id], onDelete: SetNull)
  revokedBy User? @relation("InvitationRevoker", fields: [revokedById], references: [id], onDelete: SetNull)

  @@index([userId, status])
  @@index([status, expiresAt])
  @@map("invitations")
}

/// One row per logged-in device. The refresh token rotates on every use; the previous hash is
/// kept to detect replay of an already-rotated token (the whole session is then revoked).
model RefreshSession {
  id                String                   @id @default(uuid(7)) @db.Uuid
  userId            String                   @db.Uuid
  tokenHash         String                   @unique @db.Char(64)
  previousTokenHash String?                  @unique @db.Char(64)
  /// Sliding expiry, pushed forward on each rotation.
  expiresAt         DateTime
  /// Hard upper bound: the session can never be extended past this instant.
  absoluteExpiresAt DateTime
  /// "Keep me signed in": false => cookies are browser-session cookies (kept across rotations).
  persistent        Boolean                  @default(true)
  channel           SessionChannel           @default(WEB)
  /// Set on every rotation; used for the concurrent-refresh grace window.
  lastUsedAt        DateTime?
  revokedAt         DateTime?
  revokedReason     SessionRevocationReason?
  ipAddress         String?                  @db.VarChar(45)
  userAgent         String?                  @db.VarChar(512)
  createdAt         DateTime                 @default(now())
  updatedAt         DateTime                 @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt])
  @@index([expiresAt])
  @@map("refresh_sessions")
}

model PasswordResetToken {
  id          String    @id @default(uuid(7)) @db.Uuid
  userId      String    @db.Uuid
  tokenHash   String    @unique @db.Char(64)
  expiresAt   DateTime
  usedAt      DateTime?
  requestedIp String?   @db.VarChar(45)
  createdAt   DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, usedAt])
  @@index([expiresAt])
  @@map("password_reset_tokens")
}

model EmailVerificationToken {
  id        String    @id @default(uuid(7)) @db.Uuid
  userId    String    @db.Uuid
  /// Target address (supports future email-change flows).
  email     String    @db.VarChar(254)
  tokenHash String    @unique @db.Char(64)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, usedAt])
  @@index([expiresAt])
  @@map("email_verification_tokens")
}

/// TOTP second factor, one row per user. Never loaded with the User aggregate.
/// Secrets are AES-256-GCM encrypted with MFA_ENCRYPTION_KEY, bound to the user id.
model UserMfa {
  userId               String    @id @db.Uuid
  /// Active authenticator (null until the first setup is confirmed).
  totpSecretEnc        String?   @db.VarChar(255)
  /// Last accepted time step: a code is never accepted twice (replay).
  totpLastUsedStep     Int?
  /// Setup in progress (first one, or replacing a lost phone). The active
  /// secret keeps working until this one is confirmed.
  pendingTotpSecretEnc String?   @db.VarChar(255)
  pendingTotpExpiresAt DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_mfa")
}

/// Single-use backup codes, stored as keyed hashes only (shown once, at generation).
model MfaRecoveryCode {
  id        String    @id @default(uuid(7)) @db.Uuid
  userId    String    @db.Uuid
  codeHash  String    @db.Char(64)
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, codeHash])
  @@index([userId, usedAt])
  @@map("mfa_recovery_codes")
}

/// Password verified, second factor pending. Short-lived, single-use, bounded attempts.
model MfaChallenge {
  id             String         @id @default(uuid(7)) @db.Uuid
  userId         String         @db.Uuid
  /// HMAC-SHA256 (hex) of the raw token held by the client.
  tokenHash      String         @unique @db.Char(64)
  /// The session opened on success belongs to this channel.
  channel        SessionChannel
  persistent     Boolean
  failedAttempts Int            @default(0)
  expiresAt      DateTime
  consumedAt     DateTime?
  createdAt      DateTime       @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("mfa_challenges")
}

/// Drivers who look out for each other. Exactly one OWNER (enforced by a partial
/// unique index in the migration), at most 10 members (enforced by the service
/// under a row lock).
model Family {
  id                  String    @id @default(uuid(7)) @db.Uuid
  name                String    @db.VarChar(80)
  /// Normalized join code (no dash). It only lets someone ASK to join: the
  /// owner approves every request, so it is stored readable for re-sharing.
  inviteCode          String?   @unique @db.VarChar(16)
  inviteCodeExpiresAt DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  members      FamilyMember[]
  joinRequests FamilyJoinRequest[]

  @@map("families")
}

/// One family per driver (unique userId). Sharing beyond name and photo is
/// opt-in per member; the *At columns record when consent was given.
model FamilyMember {
  id               String     @id @default(uuid(7)) @db.Uuid
  familyId         String     @db.Uuid
  userId           String     @unique @db.Uuid
  role             FamilyRole
  joinedAt         DateTime   @default(now())
  sharePhone       Boolean    @default(false)
  sharePhoneAt     DateTime?
  shareIncidents   Boolean    @default(false)
  shareIncidentsAt DateTime?
  shareHealth      Boolean    @default(false)
  shareHealthAt    DateTime?
  updatedAt        DateTime   @updatedAt

  family Family @relation(fields: [familyId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([familyId, joinedAt])
  @@map("family_members")
}

/// Created by a join code; the owner approves or rejects. At most one PENDING
/// request per driver (partial unique index in the migration).
model FamilyJoinRequest {
  id          String                  @id @default(uuid(7)) @db.Uuid
  familyId    String                  @db.Uuid
  userId      String                  @db.Uuid
  status      FamilyJoinRequestStatus @default(PENDING)
  expiresAt   DateTime
  decidedAt   DateTime?
  decidedById String?                 @db.Uuid
  createdAt   DateTime                @default(now())
  updatedAt   DateTime                @updatedAt

  family Family @relation(fields: [familyId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([familyId, status])
  @@index([userId, status])
  @@map("family_join_requests")
}

/// Append-only. No foreign keys on purpose: entries must survive hard deletes unchanged.
/// metadata is sanitized by AuditService (secrets are stripped before persistence).
model AuditLog {
  id          String         @id @default(uuid(7)) @db.Uuid
  action      String         @db.VarChar(100)
  outcome     AuditOutcome
  actorType   AuditActorType
  actorUserId String?        @db.Uuid
  targetType  String?        @db.VarChar(50)
  targetId    String?        @db.Uuid
  requestId   String?        @db.VarChar(128)
  ipAddress   String?        @db.VarChar(45)
  userAgent   String?        @db.VarChar(512)
  metadata    Json?
  createdAt   DateTime       @default(now())

  @@index([actorUserId, createdAt])
  @@index([targetType, targetId, createdAt])
  @@index([action, createdAt])
  @@map("audit_logs")
}

// ---------------------------------------------------------------- devices

enum DeviceStatus {
  ACTIVE
  REVOKED
}

/// An in-cabin detection unit. It authenticates every request with an HMAC
/// signature; the shared secret is stored encrypted (AES-256-GCM), never in clear.
model VehicleDevice {
  id                String       @id @default(uuid(7)) @db.Uuid
  serialNumber      String       @unique @db.VarChar(64)
  label             String       @db.VarChar(100)
  secretEnc         String       @db.VarChar(255)
  status            DeviceStatus @default(ACTIVE)
  /// One unit per driver, one driver per unit.
  pairedUserId      String?      @unique @db.Uuid
  pairedAt          DateTime?
  firmwareVersion   String?      @db.VarChar(50)
  associationId     String       @default(uuid(7)) @db.Uuid
  runtimeHealth     Json?
  lastSeenAt        DateTime?
  secretRotatedAt   DateTime?
  /// Set when the driver was told the unit went quiet; cleared by a heartbeat.
  offlineNotifiedAt DateTime?
  revokedAt         DateTime?
  createdById       String?      @db.Uuid
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  pairedUser User?                @relation("DevicePairedUser", fields: [pairedUserId], references: [id], onDelete: SetNull)
  nonces     DeviceRequestNonce[]
  events     MedicalEvent[]

  @@index([status])
  @@map("vehicle_devices")
}

/// Replay protection: a signed request nonce is accepted once per device
/// within the signature window, then purged.
model DeviceRequestNonce {
  deviceId  String   @db.Uuid
  nonce     String   @db.VarChar(64)
  expiresAt DateTime

  device VehicleDevice @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  @@id([deviceId, nonce])
  @@index([expiresAt])
  @@map("device_request_nonces")
}

// ---------------------------------------------------------------- safety

enum MedicalEventType {
  CARDIAC_EMERGENCY
  HEART_RHYTHM
  DROWSINESS
  SEIZURE
  STROKE
  CARDIAC_ARREST
  SOS
}

enum MedicalEventSeverity {
  WARNING
  URGENT
  CRITICAL
}

enum MedicalEventSource {
  DEVICE
  DRIVER
}

enum IncidentStatus {
  AWAITING_RESPONSE
  ESCALATED
  RESOLVED
  FALSE_ALARM
}

enum IncidentActorChannel {
  APP
  DEVICE
  SYSTEM
}

enum IncidentTimelineKind {
  OPENED
  EVENT_ADDED
  ACKNOWLEDGED
  ESCALATED
  NOTIFIED
  RESOLVED
}

enum NotificationKind {
  ALERT
  ALL_CLEAR
}

enum NotificationRecipientType {
  EMERGENCY_CONTACT
  FAMILY_MEMBER
}

enum NotificationChannel {
  LOG
  EMAIL
  SMS
  VOICE
  PUSH
}

enum NotificationStatus {
  SENT
  FAILED
  SKIPPED
}

/// A detection from an in-cabin unit, or a driver SOS. Details (readings,
/// location) are purged after the retention period.
model MedicalEvent {
  id                String               @id @default(uuid(7)) @db.Uuid
  userId            String               @db.Uuid
  deviceId          String?              @db.Uuid
  incidentId        String?              @db.Uuid
  source            MedicalEventSource
  type              MedicalEventType
  severity          MedicalEventSeverity
  /// Idempotency key chosen by the sender; one event per key and driver.
  clientEventId     String               @db.VarChar(64)
  /// 0..1 as reported by the detector.
  confidence        Float?
  detection         Json?
  payloadHash       String?              @db.VarChar(64)
  detectedAt        DateTime
  receivedAt        DateTime             @default(now())
  vitals            Json?
  latitude          Float?
  longitude         Float?
  locationAccuracyM Float?

  user     User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  device   VehicleDevice? @relation(fields: [deviceId], references: [id], onDelete: SetNull)
  incident Incident?      @relation(fields: [incidentId], references: [id], onDelete: SetNull)

  @@unique([userId, clientEventId])
  @@unique([deviceId, clientEventId])
  @@index([userId, detectedAt])
  @@index([receivedAt])
  @@map("medical_events")
}

/// A situation needing the driver's answer and, without one, help. At most one
/// active incident per driver (partial unique index in the migration).
model Incident {
  id                 String                @id @default(uuid(7)) @db.Uuid
  userId             String                @db.Uuid
  status             IncidentStatus
  severity           MedicalEventSeverity
  triggerType        MedicalEventType
  openedAt           DateTime              @default(now())
  /// Escalates when this passes without an answer. Null once settled.
  respondBy          DateTime?
  acknowledgedAt     DateTime?
  acknowledgedVia    IncidentActorChannel?
  escalatedAt        DateTime?
  resolvedAt         DateTime?
  resolvedVia        IncidentActorChannel?
  /// Outbox markers: alerts and the all-clear are delivered at least once.
  alertsSentAt       DateTime?
  allClearSentAt     DateTime?
  /// A worker owns delivery until then; a crashed worker's lease expires.
  dispatchLeaseUntil DateTime?
  latitude           Float?
  longitude          Float?
  locationAccuracyM  Float?
  createdAt          DateTime              @default(now())
  updatedAt          DateTime              @updatedAt

  user          User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  events        MedicalEvent[]
  timeline      IncidentTimelineEntry[]
  notifications IncidentNotification[]

  @@index([status, respondBy])
  @@index([userId, openedAt])
  @@index([openedAt])
  @@map("incidents")
}

model IncidentTimelineEntry {
  id         String               @id @default(uuid(7)) @db.Uuid
  incidentId String               @db.Uuid
  kind       IncidentTimelineKind
  at         DateTime             @default(now())
  /// Non-medical context only (channel, recipient count...).
  detail     Json?

  incident Incident @relation(fields: [incidentId], references: [id], onDelete: Cascade)

  @@index([incidentId, at])
  @@map("incident_timeline")
}

/// One attempt to reach someone about an incident.
model IncidentNotification {
  id              String                    @id @default(uuid(7)) @db.Uuid
  incidentId      String                    @db.Uuid
  kind            NotificationKind
  recipientType   NotificationRecipientType
  recipientUserId String?                   @db.Uuid
  recipientName   String                    @db.VarChar(200)
  /// Emergency contacts: call priority (1 = first).
  priority        Int?
  channel         NotificationChannel
  status          NotificationStatus
  error           String?                   @db.VarChar(200)
  attemptedAt     DateTime                  @default(now())

  incident Incident @relation(fields: [incidentId], references: [id], onDelete: Cascade)

  @@index([incidentId, attemptedAt])
  @@map("incident_notifications")
}

// ---------------------------------------------------------- notifications

enum NotificationCategory {
  SAFETY
  FAMILY
  SECURITY
  ACCOUNT
}

/// One entry of a user's in-app notification center. Written for its
/// recipient; never carries medical details. Purged after 90 days.
model UserNotification {
  id        String               @id @default(uuid(7)) @db.Uuid
  userId    String               @db.Uuid
  category  NotificationCategory
  /// Stable machine name, e.g. FAMILY_MEMBER_NEEDS_HELP.
  type      String               @db.VarChar(48)
  title     String               @db.VarChar(120)
  body      String               @db.VarChar(500)
  /// In-app destination (route path, e.g. /incidents/<id>), never a web URL.
  link      String?              @db.VarChar(200)
  /// Family emergencies: delivered whatever the mute settings.
  critical  Boolean              @default(false)
  readAt    DateTime?
  createdAt DateTime             @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([userId, readAt])
  @@index([createdAt])
  @@map("user_notifications")
}

/// Mute switches per category. Security has none: it always reaches the
/// center. Absent row = defaults.
model NotificationPreference {
  userId                String   @id @db.Uuid
  safety                Boolean  @default(true)
  family                Boolean  @default(true)
  account               Boolean  @default(true)
  /// Lock-screen previews may name people (never medical details).
  showNamesOnLockScreen Boolean  @default(false)
  updatedAt             DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("notification_preferences")
}
